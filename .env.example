# Copy to .env and fill in.
# Register an application at https://developers.eveonline.com
#  - Connection type: "Authorization Code" with PKCE (a public client is fine,
#    this app never uses a client secret).
#  - The callback URL must exactly match EVE_SSO_CALLBACK_* below, i.e. by
#    default: http://localhost:8000/callback
#
# Nothing listens on that port except for the few seconds a login takes -
# eve_trader_local/auth.py starts a throwaway loopback server and shuts it
# down again as soon as EVE SSO redirects back.

EVE_SSO_CLIENT_ID=your_client_id_here
EVE_SSO_CALLBACK_HOST=localhost
EVE_SSO_CALLBACK_PORT=8000
EVE_SSO_CALLBACK_PATH=/callback

# Full override for the redirect URI, if the host/port/path construction above
# doesn't produce the URL you registered.
# EVE_SSO_REDIRECT_URI=http://localhost:8000/callback

# Where the SQLite database and config.yaml live.
# Default: ~/.eve-trader-local
# EVE_TRADER_LOCAL_DATA_DIR=~/.eve-trader-local
# EVE_TRADER_LOCAL_CONFIG=~/.eve-trader-local/config.yaml

# The eve-trader-local GitHub repo is private, so the in-app update checker
# needs a token to read it (an unauthenticated request gets HTTP 404, not
# 403 - GitHub's way of not confirming a private repo exists). Create a
# classic PAT with the "repo" scope (or a fine-grained token scoped to this
# repo with Contents: Read-only) at https://github.com/settings/tokens.
# EVE_TRADER_LOCAL_GITHUB_TOKEN=ghp_your_token_here
